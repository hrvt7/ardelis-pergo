# ── Nyilvános webcím (sitemap, e-mailben küldött konfigurációs link) ──
PUBLIC_SITE_URL=https://konfigurator.pelda.hu

# ── E-mail kézbesítés (Resend, https://resend.com) ──
# A gyártó és az ügyfél e-mailjei ezen mennek ki.
RESEND_API_KEY=
# Feladó; saját domainnel kell hitelesíteni a Resendben (pl. ajanlat@pelda.hu).
LEAD_FROM_EMAIL=Pergola konfigurátor <ajanlat@pelda.hu>
# Címzett(ek), ha a gyártó fájljában nincs megadva (vesszővel elválasztva).
# A demó leadjei ide érkeznek.
LEAD_FALLBACK_EMAIL=
# 0 = ne menjen visszaigazoló e-mail az ügyfélnek.
LEAD_SEND_CONFIRMATION=1

# ── Opcionális: leadek mentése Supabase-be (supabase/leads.sql) ──
# CSAK szerveroldali kulcs — soha ne tedd VITE_ előtagú változóba!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Fejlesztés ──
# 1 = élesben is csak naplózza a leadet, ha nincs kézbesítés beállítva (NE használd élesben).
LEAD_DEV_LOG=
# Opcionális böngészős hibanapló-végpont (pl. saját gyűjtő). Üresen csak a konzolra ír.
VITE_CLIENT_LOG_ENDPOINT=
